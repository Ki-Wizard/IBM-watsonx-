# IBM watsonx Orchestrate 개발에 사용할 로컬 환경변수
WXO_ENDPOINT_URL=
WXO_API_KEY=
# 단일 에이전트 모드에서만 사용
WXO_AGENT_NAME=kiw_gamak_red_tide

# 로컬에서 국립수산과학원 적조정보를 확인할 때 사용. IBM 배포의 키는 Orchestrate 연결에 저장.
NIFS_RED_TIDE_API_KEY=

# local, watsonx (협업) 또는 watsonx-single (기존 시연)
GAMAK_MODE=local

# IBM watsonx.ai (다중 채널 초안 생성 & 임베딩 기반 매뉴얼 하이브리드 RAG)
WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com
WATSONX_AI_API_KEY=
WATSONX_AI_PROJECT_ID=
WATSONX_AI_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_AI_EMBED_MODEL_ID=intfloat/multilingual-e5-large

# IBM Cloudant (공용 승인함 동기화, 미설정 시 로컬 SQLite 사용)
CLOUDANT_URL=
CLOUDANT_APIKEY=
CLOUDANT_DB=gamak_approvals

# IBM Cloud Object Storage (공식 리포트 아카이빙, 선택 사항)
COS_ENDPOINT=
COS_BUCKET=
COS_APIKEY=
