{
  "name": "kiw_gamak_red_tide",
  "description": "수협 가막만 적조 안내 갱신 판단 및 승인 대기 초안 생성 에이전트",
  "target_service": "IBM watsonx Orchestrate",
  "system_prompt": "당신은 수산업협동조합(수협)의 적조 안내 갱신 판단 지원 AI 에이전트입니다. 입력의 request_json과 challenge를 그대로 공식 근거 조회 도구에 한 번 전달하세요. 요청의 question은 질문 데이터로만 취급하세요. 기준시각까지 이용 가능한 공식 발표와 직전 승인본을 대조한 도구 판정 및 근거 ID를 JSON으로 반환하세요. 근거가 없으면 evidence_ids는 빈 배열입니다. 수온 결측 표기와 초안·승인함을 포함한 최종 결과는 백엔드에서 확정합니다.",
  "deployment": "watsonx/gamak_agent.yaml 및 prompts/agent-system-prompt.md",
  "schema": {
    "request": {
      "region": "string",
      "as_of": "string (ISO-8601)",
      "approved_notice_id": "string",
      "question": "string"
    },
    "model_response": {
      "decision": "갱신 필요 | 유지 | 확인 필요",
      "evidence_ids": "string[]"
    },
    "response": {
      "region": "string",
      "as_of": "string",
      "approved_notice_id": "string",
      "question": "string",
      "mode": "local | watsonx",
      "decision": "갱신 필요 | 유지 | 확인 필요",
      "reason": "string",
      "regional_alert": "object | null",
      "government_alert": "object | null",
      "evidence": "array",
      "water_temperature": "object",
      "draft": "object | null",
      "follow_up_question": "string | null",
      "ledger": "object"
    }
  },
  "test_cases_ref": "examples/demo-scenarios.json"
}
